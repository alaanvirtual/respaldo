{
  "name": "pms-backend",
  "version": "1.0.0",
  "description": "PMS - Project Management System Backend (Capítulo 4: Planeación de la Aplicación)",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "start:single": "node dist/src/express_server_standalone.js",
    "dev": "nodemon --watch src -e ts --exec ts-node src/main.ts",
    "dev:single": "nodemon --watch src -e ts --exec tsx src/express_server_standalone.ts",
    "test": "node test/test-pms.js",
    "test:pms": "node test/test-pms.js",
    "test:cap5-6": "node test/test-capitulo5-6.js",
    "test:cap7-8": "node test/test-capitulo7-8.js",
    "test:mocha": "mocha --require ts-node/register \"tests/**/*.test.ts\" --timeout 15000 --exit",
    "obfuscate": "node obfuscate.js",
    "package": "node scripts/mkpackage.js"
  },
  "keywords": [
    "pms",
    "express",
    "typeorm",
    "postgresql",
    "cluster",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^2.2.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "bull": "^4.16.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.7",
    "pg": "^8.11.5",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.5",
    "@types/bull": "^3.15.9",
    "@types/chai": "^4.3.11",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.5",
    "@types/redis": "^4.0.10",
    "@types/sinon": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "chai": "^4.3.10",
    "javascript-obfuscator": "^5.9.0",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.0",
    "sinon": "^22.1.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}
