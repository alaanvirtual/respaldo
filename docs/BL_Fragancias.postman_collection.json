    {
      "name": "Perfumes - Listar Catálogo con HATEOAS",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/perfumes?brand=Parfums%20de%20Marly&inStockOnly=true",
          "host": ["{{baseUrl}}"],
          "path": ["perfumes"],
          "query": [
            { "key": "brand", "value": "Parfums de Marly" },
            { "key": "inStockOnly", "value": "true" }
          ]
        },
        "description": "Retorna el catálogo con hipermedios _links para navegación HATEOAS."
      }
    },
    {
      "name": "Perfumes - Registrar Fragancia (Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Naxos\",\n  \"brand\": \"Xerjoff\",\n  \"concentration\": \"EDP\",\n  \"sizeMl\": 100,\n  \"price\": 5800.0,\n  \"stock\": 12\n}"
        },
        "url": {
